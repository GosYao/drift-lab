region                      = "us-east-1"
account_id                  = "REPLACE_WITH_SANDBOX_ACCOUNT"
kubernetes_version          = "REPLACE_WITH_SUPPORTED_VERSION"
# For IAM Identity Center roles, use the full role ARN including its
# aws-reserved/sso.amazonaws.com/<region>/ path; EKS access entries reject the path-less form.
cluster_admin_principal_arn = "arn:aws:iam::REPLACE_ACCOUNT:role/REPLACE_REVIEWED_ADMIN"
expires_at                  = "2026-10-30T20:00:00Z"
# Optional, temporary: operator /32 for API access from outside the VPC.
# public_access_cidrs       = ["203.0.113.10/32"]
# Re-check expiry on every launch. A tag is not automatic deletion.
